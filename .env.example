# Bu dosyayı ".env" adıyla kopyala ve anahtarını yaz. .env GitHub'a gitmez.
# Anahtar: https://developer.riotgames.com (Development key 24 saatte bir yenilenir)
RIOT_API_KEY=RGAPI-buraya-anahtarin

# Bölge (TR için bunları değiştirme)
RIOT_PLATFORM=tr1
RIOT_REGION=europe

# LoL farklı bir klasöre kuruluysa (lockfile'ın olduğu klasör)
# LOL_PATH=C:\Riot Games\League of Legends
