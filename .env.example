# Bu dosyanın bir kopyasını ".env" adıyla oluştur ve anahtarını yaz. .env GitHub'a gitmez.
# Anahtar: https://developer.riotgames.com (günlük anahtar 24 saatte bir yenilenir,
# kalıcı "Personal API Key" onaylanınca onu yaz)
RIOT_API_KEY=RGAPI-buraya-anahtarin

# Bölge (TR için bunları değiştirme)
RIOT_PLATFORM=tr1
RIOT_REGION=europe

# LoL farklı bir klasöre kuruluysa (içinde "lockfile" olan klasör). Genelde gerekmez.
# LOL_PATH=C:\Riot Games\League of Legends

# Oyun içi pencereyi aç/kapat kısayolu (Electron biçimi)
# OVERLAY_HOTKEY=Control+Shift+F10

# Sorun ararken ham verileri %APPDATA%\raphael\debug klasörüne yazar
# RAPHAEL_DEBUG=1
