{
  "name": "raphael",
  "version": "0.2.0",
  "private": true,
  "description": "Kişisel League of Legends yardımcısı: şampiyon seçimi ve oyun içi bilgi",
  "author": "canoca-dev",
  "homepage": "https://github.com/canoca-dev/raphael",
  "main": "dist-electron/main/main.js",
  "scripts": {
    "build:main": "tsc -p tsconfig.main.json",
    "build:renderer": "vite build",
    "build": "npm run build:main && npm run build:renderer",
    "start": "npm run build && electron .",
    "preview:mock": "vite",
    "typecheck": "tsc -p tsconfig.main.json --noEmit && tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "e2e": "node tests/e2e/run.mjs",
    "dist": "npm run build && electron-builder --win --x64 --publish never"
  },
  "dependencies": {
    "electron-updater": "^6.8.11"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "^19.3.3",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "electron": "^45.5.0",
    "electron-builder": "^26.18.0",
    "playwright-core": "^1.63.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^5.9.3",
    "vite": "^7.3.8",
    "vitest": "^3.2.7"
  },
  "engines": {
    "node": ">=22.12"
  }
}
